# =============================================================================
# MyPerfectTrips — Production Environment Variables
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# =============================================================================

# ---- Next.js / Site ----
NEXT_PUBLIC_SITE_URL=https://myperfecttrips.com
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ---- Directus CMS ----
NEXT_PUBLIC_DIRECTUS_URL=https://admin.myperfecttrips.com
DIRECTUS_API_TOKEN=your_directus_api_token_here

# ---- Optional: Google / Bing Verification ----
# Add these meta tag values from Google Search Console / Bing Webmaster Tools
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxx
# BING_SITE_VERIFICATION=xxxxxxxxxxxx

# ---- Optional: Analytics ----
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
